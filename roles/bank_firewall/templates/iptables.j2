# Generated by Ansible — DO NOT EDIT MANUALLY
# Host: {{ inventory_hostname }}
# Date: {{ ansible_date_time.iso8601 }}
# Pipeline: {{ lookup('env', 'CI_PIPELINE_ID') | default('local') }}
# Vault: {{ firewall_use_vault | default(false) }}
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT

# Allow established connections
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

{% if firewall_allowed_icmp %}
# Allow ICMP
-A INPUT -p icmp -j ACCEPT
{% endif %}

# ── SSH whitelist from Vault ──
{% if vault_ssh_sources is defined and vault_ssh_sources | length > 0 %}
{% for src in vault_ssh_sources %}
-A INPUT -s {{ src | trim }} -p tcp --dport 22 -j ACCEPT
{% endfor %}
{% endif %}

# ── Additional rules from playbook/group_vars ──
{% for rule in bank_firewall_rules %}
# {{ rule.comment }}
{% if rule.protocol == 'all' and rule.extra_args is defined %}
-A INPUT {{ rule.extra_args }} -s {{ rule.source }} -j {{ rule.action }}
{% elif rule.protocol == 'all' %}
-A INPUT -s {{ rule.source }} -j {{ rule.action }}
{% else %}
-A INPUT -p {{ rule.protocol }} --dport {{ rule.port }} -s {{ rule.source }} -j {{ rule.action }}
{% endif %}
{% endfor %}

# Log dropped packets
-A INPUT -j LOG --log-prefix "{{ fw_drop_log_prefix | default('IPTABLES-DROP') }}: " --log-level 4

COMMIT
