! Generated by Ansible — DO NOT EDIT MANUALLY
! Host: {{ inventory_hostname }}
! Date: {{ ansible_date_time.iso8601 }}
! Pipeline: {{ lookup('env','CI_PIPELINE_ID') | default('local', true) }}
frr version 8.5
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
no ipv6 forwarding
!
{% for vlan in bank_vlans %}
{% if vlan.subnet %}
! VLAN {{ vlan.id }} — {{ vlan.name }}: {{ vlan.description }}
interface eth0.{{ vlan.id }}
 description {{ vlan.name }}-{{ vlan.description | replace(' ', '-') }}
 ip address {{ vlan.gateway }}/{{ vlan.subnet.split('/')[1] }}
!
{% endif %}
{% endfor %}
!
! NTP config
{% for ntp in ntp_servers %}
ntp server {{ ntp }}
{% endfor %}
!
line vty
!
end
